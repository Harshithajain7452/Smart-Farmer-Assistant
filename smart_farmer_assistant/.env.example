# ---------------------------------------------------------------------
# Smart Farmer Assistant — environment configuration
# Copy to `.env` and fill in your own values.  Never commit `.env`.
# ---------------------------------------------------------------------

# Flask -----------------------------------------------------------------
FLASK_ENV=development                 # development | production
SECRET_KEY=change-me-to-a-long-random-string
PORT=5000

# Database --------------------------------------------------------------
# Leave DATABASE_URL empty to fall back to a local SQLite file
# (smart_farmer.db) — handy for a zero-setup first run.
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/smart_farmer
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=yourpassword
MYSQL_DB=smart_farmer

# OpenWeatherMap --------------------------------------------------------
# Free key from https://openweathermap.org/api  (Current + 5 day forecast)
# Without a key the weather module serves a clearly-labelled sample forecast.
OPENWEATHER_API_KEY=

# Maps ------------------------------------------------------------------
# Leaflet + OpenStreetMap is the default and needs no key.
# Provide a Google Maps JS key only if you switch the map provider.
GOOGLE_MAPS_API_KEY=

# Mandi prices (data.gov.in) --------------------------------------------
# Free key from https://data.gov.in/  — resource 9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_API_KEY=

# Chatbot ---------------------------------------------------------------
# The chatbot runs on a local intent engine by default. Adding a Gemini key
# switches services/chatbot_service.py to the LLM backend automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Seeding ---------------------------------------------------------------
ADMIN_EMAIL=admin@smartfarmer.in
ADMIN_PASSWORD=Admin@1234
